{
  "$comment": "Scratch manifest for iterating on video-as-render-source content. Video files themselves are gitignored (see .gitignore) — only this manifest is tracked, so licensing/attribution and theme tags survive even as the actual clips get swapped out.",
  "themes": {
    "grunge-abstract": "Video feedback, kaleidoscope, ink/particle abstraction — pure texture, no representational content",
    "folk-horror": "Masks, ritual costume, weird figures — Midlake/Shame-by-Brad/Wicker-Man vibe",
    "retro-psa-cold-war": "1950s-60s civil-defense and educational shorts, nuclear test/launch footage — Boards of Canada sample-source vibe",
    "urban-grunge": "Cityscapes, traffic, transit, crowds, night neon",
    "nature": "Leaves, water, wildlife, desert, scenery",
    "people-scenery": "Human figures in landscape, not urban",
    "animation-weird": "Hand-drawn/animated, surreal or morphing imagery",
    "urban-decay": "Abandoned buildings, Chernobyl exclusion zone, decay, brutalist architecture — grungy and eerie",
    "vhs-glitch": "VCR UI, CRT static, SMPTE bars, tape noise, double-exposure retro-TV art — analog/broadcast glitch texture",
    "carnival": "Ferris wheels, carousels, fairground rides — nostalgic/uncanny fairground imagery"
  },
